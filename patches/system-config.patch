+/// Write a system configuration file into a temporary directory for the
+/// tests below and return its path. The directory is owned by the test
+/// user, who is passed to loadSystemFileAt as a trusted owner.
+fn testSystemFile(
+    tmp: *std.testing.TmpDir,
+    data: []const u8,
+    mode: std.fs.File.Mode,
+) ![]const u8 {
+    const alloc = std.testing.allocator;
+    try tmp.dir.chmod(0o755);
+    const file = try tmp.dir.createFile("config.ghostty", .{});
+    defer file.close();
+    try file.writeAll(data);
+    try file.chmod(mode);
+    const dir_path = try tmp.dir.realpathAlloc(alloc, ".");
+    defer alloc.free(dir_path);
+    return try std.fs.path.join(alloc, &.{ dir_path, "config.ghostty" });
+}
