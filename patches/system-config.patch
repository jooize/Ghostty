+//! The system configuration file: a configuration file that an
+//! administrator owns and Ghostty loads before any user file. It can also
+//! turn user files and command-line configuration off (see
+//! `config-default-files` and `config-cli-args`), so it is only trusted
+//! when nobody but root can change it.
+const std = @import("std");
+const builtin = @import("builtin");
+const assert = std.debug.assert;
+const Allocator = std.mem.Allocator;
+const posix = std.posix;
+
+/// The location of the system configuration file. It is fixed at build time
+/// and never read from the environment, because any process running as the
+/// user can set the environment of the next launch. On macOS, /etc is a
+/// symlink to /private/etc, so the real directory is named directly.
+pub const path = if (builtin.os.tag.isDarwin())
+    "/private/etc/ghostty/config.ghostty"
+else
+    "/etc/ghostty/config.ghostty";
+
+pub const Result = union(enum) {
+    /// The file does not exist. Every directory on the way to it passed
+    /// the checks, so only root could have removed it.
+    absent,
+
+    /// The file passed every check. The caller owns it and must close it.
+    file: std.fs.File,
+
+    /// The file exists but cannot be trusted. The message says why and is
+    /// meant for the user. It is allocated with the allocator passed to
+    /// `open`.
+    rejected: [:0]const u8,
+};
+
+/// Open the system configuration file at `abs_path` if nobody but root can
+/// change it. `trusted_uid` names one more trusted owner besides root; only
+/// tests set it.
+///
+/// The path is resolved one component at a time relative to directory
+/// handles that are already open and checked, so nothing on the way can be
+/// swapped between a check and its use. The rules:
+///
+///   * Every entry on the way, including each symlink and each symlink
+///     target, is owned by a trusted user.
+///   * Every directory is unwritable by its group and by others, unless it
+///     is sticky (such as /nix/store), where only an entry's owner can
+///     rename or remove the entry.
+///   * The file is a regular file that its group and others cannot write.
+///   * On macOS, no access control list on a directory or on the file allows
+///     anyone to write, delete or change permissions. POSIX ACLs on other
+///     systems are covered by the mode check, since the group bits hold
+///     the ACL mask.
+pub fn open(
+    alloc: Allocator,
+    abs_path: []const u8,
+    trusted_uid: ?posix.uid_t,
+) Allocator.Error!Result {
+    assert(std.fs.path.isAbsolute(abs_path));
+
+    var walk: Walk = .{
+        .arena = .init(alloc),
+        .trusted_uid = trusted_uid,
+    };
+    defer walk.deinit();
+
+    return walk.run(abs_path) catch |err| switch (err) {
+        error.OutOfMemory => return error.OutOfMemory,
+        error.Rejected => .{ .rejected = try alloc.dupeZ(u8, walk.reason) },
+    };
+}
+
+/// Symlinks followed before the path counts as a loop, as in most kernels.
+const max_symlinks = 32;
+
+const Error = Allocator.Error || error{Rejected};
+
+const Walk = struct {
+    arena: std.heap.ArenaAllocator,
+    trusted_uid: ?posix.uid_t,
+
+    /// The directories entered so far, from the root down to the current
+    /// one. Each is open and has passed `checkDir`.
+    dirs: std.ArrayListUnmanaged(Dir) = .empty,
+
+    /// Path components still to resolve, the next one last.
+    pending: std.ArrayListUnmanaged([]const u8) = .empty,
+
+    symlinks: usize = 0,
+    reason: []const u8 = "",
+
+    const Dir = struct {
+        fd: posix.fd_t,
+        path: []const u8,
+    };
+
+    fn deinit(self: *Walk) void {
+        for (self.dirs.items) |dir| posix.close(dir.fd);
+        self.arena.deinit();
+    }
+
+    fn run(self: *Walk, abs_path: []const u8) Error!Result {
+        try self.enterRoot();
+        try self.push(abs_path);
+
+        while (self.pending.pop()) |name| {
+            if (std.mem.eql(u8, name, "..")) {
+                self.leave();
+                continue;
+            }
+
+            const dir = self.dirs.getLast();
+            const entry_path = try std.fs.path.join(
+                self.arena.allocator(),
+                &.{ dir.path, name },
+            );
+            const st = posix.fstatat(
+                dir.fd,
+                name,
+                posix.AT.SYMLINK_NOFOLLOW,
+            ) catch |err| switch (err) {
+                // The directory holding the entry passed the checks, so the
+                // absence is as trustworthy as the file would be.
+                error.FileNotFound => return .absent,
+                else => return self.reject("{s}: cannot inspect it: {t}", .{ entry_path, err }),
+            };
+            try self.checkOwner(entry_path, st);
+
+            const last = self.pending.items.len == 0;
+            if (posix.S.ISLNK(st.mode)) {
+                try self.follow(dir.fd, name, entry_path);
+            } else if (posix.S.ISDIR(st.mode)) {
+                if (last) return self.reject("{s}: is a directory", .{entry_path});
+                try self.enter(dir.fd, name, entry_path, st);
+            } else if (posix.S.ISREG(st.mode)) {
+                if (!last) return self.reject("{s}: is not a directory", .{entry_path});
+                return .{ .file = try self.openFile(dir.fd, name, entry_path, st) };
+            } else {
+                return self.reject("{s}: is not a regular file", .{entry_path});
+            }
+        }
+
+        // The path named a directory, for example "/" or "/etc/..".
+        return self.reject("{s}: is a directory", .{self.dirs.getLast().path});
+    }
+
+    /// Queue the components of `p` so that the first one is resolved next.
+    fn push(self: *Walk, p: []const u8) Allocator.Error!void {
+        const alloc = self.arena.allocator();
+        const start = self.pending.items.len;
+        var it = std.mem.tokenizeScalar(u8, p, '/');
+        while (it.next()) |name| {
+            if (std.mem.eql(u8, name, ".")) continue;
+            try self.pending.append(alloc, name);
+        }
+        std.mem.reverse([]const u8, self.pending.items[start..]);
+    }
+
+    fn enterRoot(self: *Walk) Error!void {
+        const fd = posix.open("/", .{
+            .DIRECTORY = true,
+            .CLOEXEC = true,
+        }, 0) catch |err| return self.reject("/: cannot open it: {t}", .{err});
+        errdefer posix.close(fd);
+        const st = posix.fstat(fd) catch |err|
+            return self.reject("/: cannot inspect it: {t}", .{err});
+        try self.checkOwner("/", st);
+        try self.checkDir("/", fd, st);
+        try self.dirs.append(self.arena.allocator(), .{ .fd = fd, .path = "/" });
+    }
+
+    fn enter(
+        self: *Walk,
+        parent: posix.fd_t,
+        name: []const u8,
+        entry_path: []const u8,
+        lst: posix.Stat,
+    ) Error!void {
+        const fd = posix.openat(parent, name, .{
+            .DIRECTORY = true,
+            .NOFOLLOW = true,
+            .CLOEXEC = true,
+        }, 0) catch |err| return self.reject("{s}: cannot open it: {t}", .{ entry_path, err });
+        errdefer posix.close(fd);
+        const st = try self.statSame(fd, entry_path, lst);
+        try self.checkDir(entry_path, fd, st);
+        try self.dirs.append(self.arena.allocator(), .{ .fd = fd, .path = entry_path });
+    }
+
+    fn leave(self: *Walk) void {
+        // ".." at the root stays at the root, as the kernel does.
+        if (self.dirs.items.len > 1) posix.close(self.dirs.pop().?.fd);
+    }
+
+    fn follow(
+        self: *Walk,
+        parent: posix.fd_t,
+        name: []const u8,
+        entry_path: []const u8,
+    ) Error!void {
+        self.symlinks += 1;
+        if (self.symlinks > max_symlinks) {
+            return self.reject("{s}: too many levels of symbolic links", .{entry_path});
+        }
+
+        const buf = try self.arena.allocator().alloc(u8, std.fs.max_path_bytes);
+        const target = posix.readlinkat(parent, name, buf) catch |err|
+            return self.reject("{s}: cannot read the symbolic link: {t}", .{ entry_path, err });
+
+        // An absolute target starts again from the root, which stays open.
+        if (std.fs.path.isAbsolute(target)) {
+            while (self.dirs.items.len > 1) posix.close(self.dirs.pop().?.fd);
+        }
+        try self.push(target);
+    }
+
+    fn openFile(
+        self: *Walk,
+        parent: posix.fd_t,
+        name: []const u8,
+        entry_path: []const u8,
+        lst: posix.Stat,
+    ) Error!std.fs.File {
+        const fd = posix.openat(parent, name, .{
+            .NOFOLLOW = true,
+            .CLOEXEC = true,
+        }, 0) catch |err| return self.reject("{s}: cannot open it: {t}", .{ entry_path, err });
+        errdefer posix.close(fd);
+        const st = try self.statSame(fd, entry_path, lst);
+        if (st.mode & posix.S.IWGRP != 0) {
+            return self.reject("{s}: writable by its group", .{entry_path});
+        }
+        if (st.mode & posix.S.IWOTH != 0) {
+            return self.reject("{s}: writable by others", .{entry_path});
+        }
+        try self.checkAcl(entry_path, fd);
+        return .{ .handle = fd };
+    }
+
+    /// Stat an entry just opened and make sure it is the one that was
+    /// checked by name before opening it.
+    fn statSame(
+        self: *Walk,
+        fd: posix.fd_t,
+        entry_path: []const u8,
+        lst: posix.Stat,
+    ) Error!posix.Stat {
+        const st = posix.fstat(fd) catch |err|
+            return self.reject("{s}: cannot inspect it: {t}", .{ entry_path, err });
+        if (st.dev != lst.dev or st.ino != lst.ino) {
+            return self.reject("{s}: changed while it was being checked", .{entry_path});
+        }
+        return st;
+    }
+
+    fn checkOwner(self: *Walk, entry_path: []const u8, st: posix.Stat) Error!void {
+        if (st.uid == 0) return;
+        if (self.trusted_uid) |uid| if (st.uid == uid) return;
+        return self.reject("{s}: owned by uid {d}, not root", .{ entry_path, st.uid });
+    }
+
+    fn checkDir(
+        self: *Walk,
+        dir_path: []const u8,
+        fd: posix.fd_t,
+        st: posix.Stat,
+    ) Error!void {
+        // In a sticky directory only an entry's owner can rename or remove
+        // it, and every entry on the way is checked for a trusted owner.
+        if (st.mode & posix.S.ISVTX == 0) {
+            if (st.mode & posix.S.IWGRP != 0) {
+                return self.reject("{s}: writable by its group", .{dir_path});
+            }
+            if (st.mode & posix.S.IWOTH != 0) {
+                return self.reject("{s}: writable by others", .{dir_path});
+            }
+        }
+        try self.checkAcl(dir_path, fd);
+    }
+
+    fn checkAcl(self: *Walk, entry_path: []const u8, fd: posix.fd_t) Error!void {
+        if (comptime !builtin.os.tag.isDarwin()) return;
+
+        const acl = darwin_acl.acl_get_fd_np(fd, darwin_acl.ACL_TYPE_EXTENDED) orelse {
+            if (std.c._errno().* == @intFromEnum(posix.E.NOENT)) return;
+            return self.reject("{s}: cannot read its access control list", .{entry_path});
+        };
+        defer _ = darwin_acl.acl_free(acl);
+
+        var entry: ?*anyopaque = null;
+        var id: c_int = darwin_acl.ACL_FIRST_ENTRY;
+        while (darwin_acl.acl_get_entry(acl, id, &entry) == 0) : (id = darwin_acl.ACL_NEXT_ENTRY) {
+            var tag: c_int = undefined;
+            var permset: ?*anyopaque = null;
+            if (darwin_acl.acl_get_tag_type(entry, &tag) != 0 or
+                darwin_acl.acl_get_permset(entry, &permset) != 0)
+            {
+                return self.reject("{s}: cannot read its access control list", .{entry_path});
+            }
+            if (tag != darwin_acl.ACL_EXTENDED_ALLOW) continue;
+            for (darwin_acl.write_perms) |perm| {
+                if (darwin_acl.acl_get_perm_np(permset, perm) == 1) {
+                    return self.reject("{s}: an access control list allows changes", .{entry_path});
+                }
+            }
+        }
+    }
+
+    fn reject(self: *Walk, comptime fmt: []const u8, args: anytype) Error {
+        self.reason = try std.fmt.allocPrint(self.arena.allocator(), fmt, args);
+        return error.Rejected;
+    }
+};
+
+/// The part of <sys/acl.h> used here; the values are from the macOS SDK.
+const darwin_acl = struct {
+    const ACL_TYPE_EXTENDED: c_int = 0x00000100;
+    const ACL_FIRST_ENTRY: c_int = 0;
+    const ACL_NEXT_ENTRY: c_int = -1;
+    const ACL_EXTENDED_ALLOW: c_int = 1;
+
+    /// Permissions that let someone change an entry or what it contains.
+    const write_perms = [_]c_int{
+        1 << 2, // ACL_WRITE_DATA, ACL_ADD_FILE
+        1 << 4, // ACL_DELETE
+        1 << 5, // ACL_APPEND_DATA, ACL_ADD_SUBDIRECTORY
+        1 << 6, // ACL_DELETE_CHILD
+        1 << 8, // ACL_WRITE_ATTRIBUTES
+        1 << 10, // ACL_WRITE_EXTATTRIBUTES
+        1 << 12, // ACL_WRITE_SECURITY
+        1 << 13, // ACL_CHANGE_OWNER
+    };
+
+    extern "c" fn acl_get_fd_np(fd: c_int, ty: c_int) ?*anyopaque;
+    extern "c" fn acl_free(obj: *anyopaque) c_int;
+    extern "c" fn acl_get_entry(acl: *anyopaque, entry_id: c_int, entry: *?*anyopaque) c_int;
+    extern "c" fn acl_get_tag_type(entry: ?*anyopaque, tag: *c_int) c_int;
+    extern "c" fn acl_get_permset(entry: ?*anyopaque, permset: *?*anyopaque) c_int;
+    extern "c" fn acl_get_perm_np(permset: ?*anyopaque, perm: c_int) c_int;
+};
+
+// The tests run in a temporary directory owned by the test user, so they
+// pass that user as `trusted_uid`. They assume that no directory above it is
+// writable by its group or others (true for a home directory or a CI
+// workspace with the usual umask).
+
+const TestDir = struct {
+    tmp: std.testing.TmpDir,
+    path: []const u8,
+
+    fn init() !TestDir {
+        var tmp = std.testing.tmpDir(.{});
+        errdefer tmp.cleanup();
+        try tmp.dir.chmod(0o755);
+        const p = try tmp.dir.realpathAlloc(std.testing.allocator, ".");
+        return .{ .tmp = tmp, .path = p };
+    }
+
+    fn deinit(self: *TestDir) void {
+        std.testing.allocator.free(self.path);
+        self.tmp.cleanup();
+    }
+
+    fn join(self: *const TestDir, sub: []const u8) ![]const u8 {
+        return std.fs.path.join(std.testing.allocator, &.{ self.path, sub });
+    }
+
+    fn writeFile(self: *const TestDir, sub: []const u8, mode: std.fs.File.Mode) !void {
+        const file = try self.tmp.dir.createFile(sub, .{});
+        defer file.close();
+        try file.writeAll("font-size = 20\n");
+        try file.chmod(mode);
+    }
+
+    fn check(self: *const TestDir, sub: []const u8) !Result {
+        const p = try self.join(sub);
+        defer std.testing.allocator.free(p);
+        return try open(std.testing.allocator, p, posix.getuid());
+    }
+};
+
+fn expectFile(result: Result) !void {
+    switch (result) {
+        .file => |f| f.close(),
+        .absent => return error.TestExpectedFile,
+        .rejected => |msg| {
+            defer std.testing.allocator.free(msg);
+            std.debug.print("unexpected rejection: {s}\n", .{msg});
+            return error.TestExpectedFile;
+        },
+    }
+}
+
+fn expectAbsent(result: Result) !void {
+    switch (result) {
+        .absent => {},
+        .file => |f| {
+            f.close();
+            return error.TestExpectedAbsent;
+        },
+        .rejected => |msg| {
+            defer std.testing.allocator.free(msg);
+            std.debug.print("unexpected rejection: {s}\n", .{msg});
+            return error.TestExpectedAbsent;
+        },
+    }
+}
+
+fn expectRejected(result: Result, needle: []const u8) !void {
+    switch (result) {
+        .file => |f| {
+            f.close();
+            return error.TestExpectedRejection;
+        },
+        .absent => return error.TestExpectedRejection,
+        .rejected => |msg| {
+            defer std.testing.allocator.free(msg);
+            if (std.mem.indexOf(u8, msg, needle) == null) {
+                std.debug.print("rejection without \"{s}\": {s}\n", .{ needle, msg });
+                return error.TestUnexpectedMessage;
+            }
+        },
+    }
+}
