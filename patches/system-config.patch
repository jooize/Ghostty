+    defer env: {
+        const value = saved orelse {
+            _ = env_os.unsetenv("GHOSTTY_RESOURCES_DIR");
+            break :env;
+        };
+        _ = env_os.setenv("GHOSTTY_RESOURCES_DIR", value);
+        alloc.free(value);
+    }
+    const planted = "/nonexistent/ghostty-test-resources";
+    _ = env_os.setenv("GHOSTTY_RESOURCES_DIR", planted);
+
+    var dir = try resourcesDir(alloc);
