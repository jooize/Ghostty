+        try t.tmp.dir.makeDir(name);
+        try t.writeFile(name ++ "/config.ghostty", 0o644);
+    }
+    var open_dir = try t.tmp.dir.openDir("open", .{});
+    defer open_dir.close();
+    try open_dir.chmod(0o775);
+    var sticky_dir = try t.tmp.dir.openDir("sticky", .{});
+    defer sticky_dir.close();
+    try sticky_dir.chmod(0o1777);
+
+    try expectRejected(try t.check("open/config.ghostty"), "writable by its group");
+    try expectFile(try t.check("sticky/config.ghostty"));
+}
+
+test "system file: symbolic links are followed and checked" {
+    var t = try TestDir.init();
+    defer t.deinit();
+    try t.tmp.dir.makeDir("store");
+    try t.writeFile("store/config.ghostty", 0o644);
+
+    // A relative link to a link with an absolute target, as nix-darwin
+    // links /etc into the Nix store.
+    const abs_target = try t.join("store/config.ghostty");
+    defer std.testing.allocator.free(abs_target);
+    try t.tmp.dir.symLink(abs_target, "static", .{});
+    try t.tmp.dir.symLink("./static", "config.ghostty", .{});
+    try expectFile(try t.check("config.ghostty"));
+
+    // ".." inside a link target resolves against the link's directory.
+    try t.tmp.dir.symLink("../store/config.ghostty", "store/up", .{});
+    try expectFile(try t.check("store/up"));
+
+    try t.tmp.dir.symLink("loop-b", "loop-a", .{});
+    try t.tmp.dir.symLink("loop-a", "loop-b", .{});
+    try expectRejected(try t.check("loop-a"), "too many levels of symbolic links");
+
+    try t.tmp.dir.symLink("missing", "dangling", .{});
+    try expectAbsent(try t.check("dangling"));
+}
+
+test "system file: directories and non-directories in the wrong place are rejected" {
+    var t = try TestDir.init();
+    defer t.deinit();
+    try t.tmp.dir.makeDir("dir");
+    try t.writeFile("file", 0o644);
+    try expectRejected(try t.check("dir"), "is a directory");
+    try expectRejected(try t.check("file/config.ghostty"), "is not a directory");
+}
+
+test "system file: an entry not owned by root is rejected" {
+    if (posix.getuid() == 0) return error.SkipZigTest;
+    var t = try TestDir.init();
+    defer t.deinit();
+    try t.writeFile("config.ghostty", 0o644);
+    const p = try t.join("config.ghostty");
+    defer std.testing.allocator.free(p);
+    try expectRejected(try open(std.testing.allocator, p, null), "not root");
+}
+
+test "system file: an access control list that allows changes is rejected" {
+    if (comptime !builtin.os.tag.isDarwin()) return error.SkipZigTest;
+    var t = try TestDir.init();
+    defer t.deinit();
+    try t.writeFile("allow", 0o644);
+    try t.writeFile("deny", 0o644);
+    try addAcl(&t, "allow", "everyone allow write");
+    try addAcl(&t, "deny", "everyone deny delete");
+    try expectRejected(try t.check("allow"), "an access control list allows changes");
+    try expectFile(try t.check("deny"));
+}
+
+fn addAcl(t: *const TestDir, sub: []const u8, entry: []const u8) !void {
+    const alloc = std.testing.allocator;
+    const p = try t.join(sub);
+    defer alloc.free(p);
+    const result = try std.process.Child.run(.{
+        .allocator = alloc,
+        .argv = &.{ "/bin/chmod", "+a", entry, p },
+    });
+    defer alloc.free(result.stdout);
+    defer alloc.free(result.stderr);
+    try std.testing.expectEqual(std.process.Child.Term{ .Exited = 0 }, result.term);
+}
