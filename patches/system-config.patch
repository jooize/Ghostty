+/// What the system configuration file decided. It is kept apart from the
+/// public fields so that nothing loaded after the system file can change it.
+const System = struct {
+    /// True once loadSystemFile has run; it only runs once per config.
+    loaded: bool = false,
+
+    /// True if a system file exists and passed the check. Theme lookup then
+    /// ignores GHOSTTY_RESOURCES_DIR.
+    trusted: bool = false,
+
+    /// Whether user configuration files may be loaded: the default files,
+    /// a file named by GHOSTTY_CONFIG_PATH on macOS, and user themes.
+    default_files: bool = true,
+
+    /// Whether command-line configuration may be loaded.
+    cli_args: bool = true,
+
+    /// The replay steps the system file recorded. These are only valid
+    /// until finalize, which rebuilds the replay steps for themes.
+    replay_start: usize = 0,
+    replay_end: usize = 0,
+};
+
+/// Load the system configuration file, if it exists and nobody but root can
+/// change it. See `config-default-files` for the rules. This runs before any
+/// other configuration is loaded; loadDefaultFiles and loadCliArgs call it
+/// themselves, and later calls do nothing.
+///
+/// Returns whether user configuration files may be loaded, for callers that
+/// load a user file directly (the macOS app with GHOSTTY_CONFIG_PATH).
+pub fn loadSystemFile(self: *Config, alloc_gpa: Allocator) !bool {
+    try self.loadSystemFileAt(alloc_gpa, system_file.path, null);
+    return self._system.default_files;
+}
+
+/// loadSystemFile with the path and an extra trusted owner as parameters,
+/// so tests can use a temporary directory.
+fn loadSystemFileAt(
+    self: *Config,
+    alloc_gpa: Allocator,
+    path: []const u8,
+    trusted_uid: ?std.posix.uid_t,
+) !void {
+    if (self._system.loaded) return;
+    self._system.loaded = true;
+
+    // Refuse user files until the system file is known to be absent or has
+    // loaded, so that an error on the way fails closed.
+    self._system.default_files = false;
+    self._system.cli_args = false;
+
+    const arena_alloc = self._arena.?.allocator();
+    var file = switch (try system_file.open(arena_alloc, path, trusted_uid)) {
+        .file => |file| file,
+        .absent => switch (build_config.system_config) {
+            .optional => {
+                self._system.default_files = true;
+                self._system.cli_args = true;
+                return;
+            },
+            .required => return try self.rejectSystemFile(path, try std.fmt.allocPrint(
+                arena_alloc,
+                "{s}: does not exist, and this build of Ghostty requires it",
+                .{path},
+            )),
+        },
+        .rejected => |reason| return try self.rejectSystemFile(path, reason),
+    };
+    defer file.close();
+    self._system.trusted = true;
+
+    self._system.replay_start = self._replay_steps.items.len;
+    self.loadFsFile(alloc_gpa, &file, path) catch |err| switch (err) {
+        error.OutOfMemory => return error.OutOfMemory,
+        else => return try self.rejectSystemFile(path, try std.fmt.allocPrint(
+            arena_alloc,
+            "{s}: cannot read it: {t}",
+            .{ path, err },
+        )),
+    };
+    self._system.replay_end = self._replay_steps.items.len;
+
+    // Capture the settings only the system file may make, then put the
+    // public fields back so a later value has nothing to change.
+    self._system.default_files = self.@"config-default-files";
+    self._system.cli_args = self.@"config-cli-args";
+    self.@"config-default-files" = true;
+    self.@"config-cli-args" = true;
+}
+
+/// Fall back to the built-in defaults and say why. A system file that
+/// cannot be trusted might have been meant to turn user files off, so user
+/// files and command-line configuration are skipped too.
+fn rejectSystemFile(self: *Config, path: []const u8, reason: []const u8) !void {
+    self._system.default_files = false;
+    self._system.cli_args = false;
+
+    const arena_alloc = self._arena.?.allocator();
+    const diag: cli.Diagnostic = .{
+        .message = try std.fmt.allocPrintSentinel(
+            arena_alloc,
+            "not loading the system configuration file {s} ({s}); " ++
+                "using the built-in defaults and ignoring user configuration " ++
+                "files and command-line configuration",
+            .{ path, reason },
+            0,
+        ),
+    };
+    log.warn("{s}", .{diag.message});
+    try self._diagnostics.append(arena_alloc, diag);
+    try self._replay_steps.append(arena_alloc, .{ .diagnostic = diag });
+}
