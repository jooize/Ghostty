+test "resources dir from the executable" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+
+    const share = if (builtin.target.os.tag == .freebsd) "local/share" else "share";
