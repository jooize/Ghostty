+    const base = try tmp.dir.realpathAlloc(alloc, ".");
+    defer alloc.free(base);
+
+    const exe = try std.fs.path.join(alloc, &.{ base, "bin", "ghostty" });
+    defer alloc.free(exe);
+    const dir = (try resourcesDirFromExePath(alloc, exe)).?;
+    defer alloc.free(dir);
+    const expected = try std.fs.path.join(alloc, &.{ base, share, "ghostty" });
+    defer alloc.free(expected);
+    try testing.expectEqualStrings(expected, dir);
+
+    try testing.expect(try resourcesDirFromExePath(alloc, "/ghostty") == null);
