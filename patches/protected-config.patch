+/// Open a configuration file by its absolute path. Under
+/// `config-file-protection = required`, the file must pass the check in
+/// system_file.zig and is opened through it. A file that fails is reported
+/// as a diagnostic, and error.ProtectedFileRejected is returned.
+fn openConfigFile(self: *Config, path: []const u8) !std.fs.File {
+    if (self._system.protection != .required) {
+        return try std.fs.openFileAbsolute(path, .{});
+    }
+
+    const arena_alloc = self._arena.?.allocator();
+    return switch (try system_file.openProtected(arena_alloc, path, std.posix.getuid())) {
+        .file => |file| file,
+        .absent => error.FileNotFound,
+        .rejected => |reason| {
+            const diag: cli.Diagnostic = .{
+                .message = try std.fmt.allocPrintSentinel(
+                    arena_alloc,
+                    "not loading {s}: {s}",
+                    .{ path, reason },
+                    0,
+                ),
+            };
+            log.warn("{s}", .{diag.message});
+            try self._diagnostics.append(arena_alloc, diag);
+            try self._replay_steps.append(arena_alloc, .{ .diagnostic = diag });
+            return error.ProtectedFileRejected;
+        },
+    };
+}
