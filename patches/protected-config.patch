+/// Under `config-file-protection = required`, drop every file a setting
+/// names that fails the check in system_file.zig, with a diagnostic that
+/// says why. The file is opened by its path later, but a path that passes
+/// is pinned: the user can change neither the file nor any directory on
+/// the way to it.
+fn checkProtectedFiles(self: *Config) !void {
+    if (self._system.protection != .required) return;
+
+    inline for (@typeInfo(Config).@"struct".fields) |field| {
+        switch (field.type) {
+            // loadRecursiveFiles checks each config-file as it opens it.
+            RepeatablePath => if (comptime !std.mem.eql(u8, field.name, "config-file")) {
+                const list = &@field(self, field.name).value;
+                var kept: usize = 0;
+                for (list.items) |path| {
+                    if (!try self.checkProtectedPath(field.name, path)) continue;
+                    list.items[kept] = path;
+                    kept += 1;
+                }
+                list.shrinkRetainingCapacity(kept);
+            },
+
+            ?Path => if (@field(self, field.name)) |path| {
+                if (!try self.checkProtectedPath(field.name, path)) {
+                    @field(self, field.name) = null;
+                }
+            },
+
+            // A path that cannot be dropped needs its own handling here.
+            Path, ?RepeatablePath => @compileError(
+                "config-file-protection does not check " ++ field.name,
+            ),
+
+            else => {},
+        }
+    }
+
+    // An input path is read into the terminal as if typed. It is opened
+    // later with its escape sequences parsed (ReadableIO.cloneParsed), so
+    // that is the path to check.
+    {
+        const arena_alloc = self._arena.?.allocator();
+        const list = &self.input.list;
+        var kept: usize = 0;
+        for (list.items) |item| {
+            switch (item) {
+                .raw => {},
+                .path => |raw| {
+                    const buf = try arena_alloc.alloc(u8, raw.len);
+                    const path = string.parse(buf, raw) catch continue;
+                    if (!try self.checkProtectedFile("input", path, false)) continue;
+                },
+            }
+            list.items[kept] = item;
+            kept += 1;
+        }
+        list.shrinkRetainingCapacity(kept);
+    }
+
+    // The macOS app loads the custom icon from ~/.config/ghostty/Ghostty.icns
+    // when `macos-custom-icon` is unset. If the file fails the check, the
+    // official icon is used.
+    if (comptime builtin.os.tag == .macos) if (self.@"macos-icon" == .custom) {
+        const arena_alloc = self._arena.?.allocator();
+        const value = self.@"macos-custom-icon" orelse "~/.config/ghostty/Ghostty.icns";
+        const path: [:0]const u8 = if (std.mem.startsWith(u8, value, "~/"))
+            if (try system_file.userHome(arena_alloc)) |home|
+                try std.mem.concatWithSentinel(arena_alloc, u8, &.{ home, value[1..] }, 0)
+            else
+                value
+        else
+            value;
+        const optional = self.@"macos-custom-icon" == null;
+        if (try self.checkProtectedFile("macos-custom-icon", path, optional)) {
+            self.@"macos-custom-icon" = path;
+        } else {
+            self.@"macos-icon" = .official;
+        }
+    };
 }
 
+/// checkProtectedFile for a Path value.
+fn checkProtectedPath(self: *Config, comptime key: [:0]const u8, path: Path) !bool {
+    return switch (path) {
+        // Path.expand blanks a path it cannot expand, and reports it.
+        .optional, .required => |value| if (value.len == 0)
+            false
+        else
+            try self.checkProtectedFile(key, value, path == .optional),
+    };
+}
+
+/// Whether the file at `path`, named by the setting `key`, passes the check
+/// for `config-file-protection`. If not, a diagnostic says why, unless the
+/// file is optional and does not exist.
+fn checkProtectedFile(
+    self: *Config,
+    comptime key: [:0]const u8,
+    path: []const u8,
+    optional: bool,
+) !bool {
+    const arena_alloc = self._arena.?.allocator();
+    const reason: []const u8 = check: {
+        if (!std.fs.path.isAbsolute(path)) break :check "not an absolute path";
+        switch (try system_file.openProtected(arena_alloc, path, std.posix.getuid())) {
+            .file => |file| {
+                file.close();
+                return true;
+            },
+            .absent => {
+                if (optional) return false;
+                break :check "it does not exist";
+            },
+            .rejected => |message| break :check message,
+        }
+    };
+
+    const diag: cli.Diagnostic = .{
+        .key = key,
+        .message = try std.fmt.allocPrintSentinel(
+            arena_alloc,
+            "not loading {s}: {s}",
+            .{ path, reason },
+            0,
+        ),
+    };
+    log.warn("{s}: {s}", .{ key, diag.message });
+    try self._diagnostics.append(arena_alloc, diag);
+    return false;
+}
