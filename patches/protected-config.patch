+/// Expand a leading `~/` in a path value from `home`, the home directory in
+/// the user database (see expandPaths). Without one, the path is blanked
+/// and a diagnostic says why, as Path.expand does when it finds no home.
+fn expandUserHome(
+    self: *Config,
+    value: anytype,
+    home: ?[]const u8,
+) Allocator.Error!void {
+    switch (@TypeOf(value.*)) {
+        RepeatablePath => for (value.value.items) |*path| {
+            try self.expandUserHome(path, home);
+        },
+
+        Path => {
+            const path = switch (value.*) {
+                .optional, .required => |path| path,
+            };
+            if (!std.mem.startsWith(u8, path, "~/")) return;
+
+            const arena_alloc = self._arena.?.allocator();
+            const home_dir = home orelse {
+                try self._diagnostics.append(arena_alloc, .{
+                    .message = try std.fmt.allocPrintSentinel(
+                        arena_alloc,
+                        "error expanding home directory for path {s}: " ++
+                            "the user database has no home directory for you",
+                        .{path},
+                        0,
+                    ),
+                });
+                value.* = .{ .required = "" };
+                return;
+            };
+            const expanded = try std.mem.concatWithSentinel(
+                arena_alloc,
+                u8,
+                &.{ home_dir, path[1..] },
+                0,
+            );
+            switch (value.*) {
+                .optional, .required => |*p| p.* = expanded,
+            }
+        },
+
+        else => @compileError("not a path type"),
+    }
+}
