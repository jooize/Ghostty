+/// Load the legacy `config` file and then `config.ghostty` from `dir`.
+fn loadProtectedDefaultDir(self: *Config, alloc: Allocator, dir: []const u8) !void {
+    for ([_][]const u8{ "config", "config.ghostty" }) |name| {
+        const path = try std.fs.path.join(alloc, &.{ dir, name });
+        defer alloc.free(path);
+        _ = self.loadOptionalFile(alloc, path);
