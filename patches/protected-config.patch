+/// Whether `cfg` has a diagnostic for `key` whose message contains `needle`.
+fn testHasDiagnostic(cfg: *const Config, key: []const u8, needle: []const u8) bool {
+    for (cfg._diagnostics.items()) |diag| {
+        if (std.mem.eql(u8, diag.key, key) and
+            std.mem.indexOf(u8, diag.message, needle) != null) return true;
+    }
+    return false;
+}
