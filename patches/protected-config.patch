+test "config-file-protection: only the system file can turn it on" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+
+    {
+        const path = try testSystemFile(&tmp, "config-file-protection = required\n", 0o644);
+        defer alloc.free(path);
+        var cfg = try Config.default(alloc);
+        defer cfg.deinit();
+        try cfg.loadSystemFileAt(alloc, path, std.posix.getuid());
+        try testing.expect(cfg._diagnostics.empty());
+        try testing.expectEqual(.required, cfg._system.protection);
+        try testing.expectEqual(.off, cfg.@"config-file-protection");
+
+        var reader: std.Io.Reader = .fixed("config-file-protection = off\n");
+        try cfg.loadReader(alloc, &reader, "/home/ghostty/.config/ghostty/config.ghostty");
+        try testing.expectEqual(.required, cfg._system.protection);
+    }
+
+    {
+        const path = try testSystemFile(&tmp, "font-size = 20\n", 0o644);
+        defer alloc.free(path);
+        var cfg = try Config.default(alloc);
+        defer cfg.deinit();
+        try cfg.loadSystemFileAt(alloc, path, std.posix.getuid());
+        try testing.expectEqual(.off, cfg._system.protection);
+
+        var reader: std.Io.Reader = .fixed("config-file-protection = required\n");
+        try cfg.loadReader(alloc, &reader, "/home/ghostty/.config/ghostty/config.ghostty");
+        try testing.expectEqual(.off, cfg._system.protection);
+    }
+}
