+/// loadDefaultFiles under `config-file-protection = required`. The files
+/// are the usual ones, but their locations come from the home directory in
+/// the user database, never from HOME, XDG_CONFIG_HOME or CFFIXED_USER_HOME,
+/// which any process running as the user can set for the next launch.
+/// loadFile checks each file, and no template file is written.
+fn loadProtectedDefaultFiles(self: *Config, alloc: Allocator) !void {
+    const home = try system_file.userHome(alloc) orelse {
+        const arena_alloc = self._arena.?.allocator();
+        const diag: cli.Diagnostic = .{
+            .message = "not loading the default configuration files: " ++
+                "the user database has no home directory for you",
+        };
+        log.warn("{s}", .{diag.message});
+        try self._diagnostics.append(arena_alloc, diag);
+        try self._replay_steps.append(arena_alloc, .{ .diagnostic = diag });
+        return;
+    };
+    defer alloc.free(home);
+
+    const xdg_dir = try internal_os.xdg.config(alloc, .{
+        .subdir = "ghostty",
+        .home = home,
+    });
+    defer alloc.free(xdg_dir);
+    try self.loadProtectedDefaultDir(alloc, xdg_dir);
+
+    if (comptime builtin.os.tag == .macos) {
+        const app_support_dir = try std.fs.path.join(alloc, &.{
+            home,
+            "Library",
+            "Application Support",
+            build_config.bundle_id,
+        });
+        defer alloc.free(app_support_dir);
+        try self.loadProtectedDefaultDir(alloc, app_support_dir);
+    }
+}
